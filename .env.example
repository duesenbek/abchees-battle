# Environment variables for ABCHESS Duel
# Copy this file to .env and replace the values if you deploy your own backend.

# Example: API endpoint for fetching puzzles
VITE_API_URL=https://api.example.com

# Example: WebSocket server for multiplayer matches
VITE_WS_URL=wss://ws.example.com

# Example: Analytics Tracking ID
VITE_ANALYTICS_ID=UA-XXXXX-Y
